# ──────────────────────────────────────────────────────────────
# Local Delivery Storefront — env template
# Copy to .env.local and fill in your real keys.
# Never commit .env.local.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for Stripe redirects, email links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public business name shown in the UI (keep it generic if you want)
NEXT_PUBLIC_BRAND_NAME=Local Delivery Co.

# Optional. Path or URL to your logo image. When set, the logo replaces the
# brand text in the nav, login screen, and emails. Examples:
#   /logo.png              (file lives in /public)
#   https://cdn.../logo.svg
# Leave blank to show the brand name in the serif typeface.
NEXT_PUBLIC_LOGO_URL=

# Discreet billing descriptor reminder shown to customers (UI copy only;
# the actual descriptor must also be set in your Stripe dashboard).
NEXT_PUBLIC_BILLING_DESCRIPTOR=LDC

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin/courier API routes for privileged actions.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name for courier delivery photos.
SUPABASE_DELIVERY_PHOTO_BUCKET=delivery-photos

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Google Maps Distance Matrix ───────────────────────────────
GOOGLE_MAPS_API_KEY=
# Store origin used to compute delivery distance.
STORE_ORIGIN_ADDRESS=

# ── Twilio (SMS) ──────────────────────────────────────────────
# Leave blank to disable SMS; the app will log instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── SendGrid (Email) ──────────────────────────────────────────
# Leave blank to disable email; the app will log instead.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Local Delivery Co.

# ── Admin alerts ──────────────────────────────────────────────
# Where to send new-order / new-account alerts (comma-separated).
ADMIN_ALERT_EMAILS=
ADMIN_ALERT_PHONES=
